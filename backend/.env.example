DATABASE_URL=postgresql://user:password@localhost:5432/airfawers_db
PORT=4000

# Sécurité — OBLIGATOIRE (dev + prod). Min. 16 caractères, pas de valeur d'exemple.
# Générer : openssl rand -hex 32
JWT_SECRET=remplacez_par_une_cle_aleatoire_longue
JWT_EXPIRATION=24h

# Bootstrap 1er admin (CLI uniquement — pas d'endpoint public) :
#   cd backend
#   node scripts/createAdmin.js --email admin@exemple.com --password "MotDePasseFort"
#   # ou : ADMIN_EMAIL=... ADMIN_PASSWORD=... node scripts/createAdmin.js

# Email — local (Gmail SMTP)
EMAIL_USER=
EMAIL_PASSWORD=

# Email — production Railway (Brevo)
# BREVO_API_KEY=
# EMAIL_FROM=
# EMAIL_FROM_NAME=

# Cloudinary — upload photos profil chauffeur
# Dashboard : https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS (production)
# CORS_ORIGIN=https://airfawers-auto.vercel.app

# URL du frontend (lien espace chauffeur dans les emails)
FRONTEND_URL=https://airfawers-auto.vercel.app
