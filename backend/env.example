# Email — production Railway (Brevo API, recommandé)
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=airfawersauto@gmail.com
EMAIL_FROM_NAME=Airfawers Auto

# Email — développement local (Gmail SMTP, optionnel)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_PASSWORD=your-app-password

# Base de données PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/airfawers_db"

# Serveur
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Sécurité — OBLIGATOIRE (dev + prod). Min. 16 caractères.
# Interdit : secret, change_me, your-secret-key, etc.
# Générer : openssl rand -hex 32
JWT_SECRET=remplacez_par_une_cle_aleatoire_longue

# Bootstrap 1er admin (script CLI uniquement) :
#   node scripts/createAdmin.js --email admin@exemple.com --password "MotDePasseFort8+"
#   # Variables : ADMIN_EMAIL, ADMIN_PASSWORD, ADMIN_NOM, ADMIN_PRENOM

# CORS — URL(s) du frontend Vercel, séparées par des virgules
# Exemple : https://airfawers-auto.vercel.app,https://www.votredomaine.com
CORS_ORIGIN=http://localhost:5173
