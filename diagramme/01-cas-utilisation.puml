admin --> UC_A82
admin --> UC_A83

' ==========================================================
' Relations Chauffeur
' ==========================================================
chauffeur --> UC_C01
chauffeur --> UC_C02
chauffeur --> UC_C03
chauffeur --> UC_C04
chauffeur --> UC_LOGOUT
chauffeur --> UC_C10
chauffeur --> UC_C20
chauffeur --> UC_C21
chauffeur --> UC_C22
chauffeur --> UC_C30
chauffeur --> UC_C31
chauffeur --> UC_C40
chauffeur --> UC_C41
chauffeur --> UC_C42
